# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Dev builds only: a local backend (../Break-for-cars-backend `npm start`), e.g. ws://localhost:2567.
# Deployed builds ignore it and always connect through the Bloxity matchmaker.
VITE_SERVER_URL=
